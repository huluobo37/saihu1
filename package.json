{
  "name": "amazon-ads-analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local-first Amazon Ads Analytics for Saihu ERP reports, based on Colony.",
  "keywords": [
    "ant-design",
    "antd",
    "admin",
    "dashboard",
    "template",
    "react",
    "vite",
    "typescript"
  ],
  "homepage": "https://github.com/ColorlibHQ/colony",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColorlibHQ/colony.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vite build --logLevel error && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "vite build && node scripts/bundle-budget.mjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.76.1",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^6.6.1",
    "dayjs": "^1.11.23",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
